      "preliminary": {
        "visible": true,
        "scheme": "lowerRoman",
        "position": "bottom-center",
        "start": 1
      },
      "main_body": {
        "visible": true,
        "scheme": "decimal",
        "position": "bottom-center",
        "restart_at_chapter_one": true,
        "start": 1
      },
      "table_of_contents": {
        "auto_generated": true,
        "real_page_numbers": true
      }
    }
  },
  "required_fields": [
    "full_name",
    "matric_number",
    "university_name",
    "department",
    "faculty",
    "organization_name",
    "organization_address",
    "training_start_date",
    "training_end_date",
    "logbook_entries"
  ],
  "optional_fields": [
    "placement_department",
    "industry_supervisor_name",
    "academic_supervisor_name"
