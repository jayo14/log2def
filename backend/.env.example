# ==============================================================================
# LOG2DEF BACKEND ENVIRONMENT CONFIGURATION (PRODUCTION & DEVELOPMENT)
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Set DJANGO_DEBUG to False in production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,log2def.vercel.app,.vercel.app,.onrender.com,.railway.app,.fly.dev

# --- DATABASE CONFIGURATION ---
# For Cloud Services (Rumpty Cloud, Render, Railway, Neon, Supabase): provide DATABASE_URL
# Example: DATABASE_URL=postgresql://postgres:password@pg-host.ws-project.db.rumptycloud.com:5432/log2def?sslmode=require
DATABASE_URL=
DATABASE_URL_POOLED=
DATABASE_URL_UNPOOLED=
# Internal connection string when deployed directly on Rumpty Cloud infrastructure:
DATABASE_URL_INTERNAL=

# Alternatively, set individual PostgreSQL connection parameters or sqlite:
DB_ENGINE=postgres
DB_NAME=log2def
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# --- OBJECT STORAGE (S3-COMPATIBLE: RUMPTY CLOUD / NEON / AWS) ---
AWS_ENDPOINT_URL_S3=https://s3.rumptycloud.com
AWS_REGION=olas-closet
S3_BUCKET=assets-mika-01a0f86f-84afac
S3_PUBLIC_URL=https://assets.rumptycloud.app/projects/YOUR_PROJECT_ID/YOUR_BUCKET_NAME
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# --- AI & MULTIMODAL PROVIDER CONFIGURATION ---
# Primary Vision & Synthesis provider: Google Gemini (gemini-2.0-flash / gemini-1.5-flash)
# Get your API key from Google AI Studio: https://aistudio.google.com
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional OpenAI or compatible fallback (e.g. Groq, OpenRouter, self-hosted vLLM)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- CORS & DOMAIN ORIGIN CONFIGURATION ---
# Comma-separated list of trusted origins for CSRF & CORS (e.g. your deployed frontend URL)
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=https://log2def.com,https://*.vercel.app,https://*.onrender.com,https://*.railway.app

# --- EXTERNAL BINARY DEPENDENCIES ---
# Paths to external binaries installed in Docker / system (default: available in PATH)
LIBREOFFICE_PATH=/usr/bin/libreoffice
TESSERACT_CMD=/usr/bin/tesseract

# --- PRODUCTION SECURITY & SSL ---
# Enable in production environments with SSL termination
DJANGO_SECURE_SSL_REDIRECT=True

# --- SQUAD PAYMENT GATEWAY ---
# Get keys from your Squad Dashboard (https://dashboard.squadco.com)
SQUAD_SECRET_KEY=your_squad_secret_key_here
SQUAD_PUBLIC_KEY=your_squad_public_key_here
SQUAD_ENV=sandbox

# --- TELEGRAM NOTIFICATIONS ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- FRONTEND URL (for Squad callback redirects) ---
FRONTEND_URL=http://localhost:3000
