# ==============================================================================
# LOG2DEF FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- BACKEND API REVERSE PROXY ROUTING ---
# Next.js forwards all client /api/* requests to BACKEND_API_URL seamlessly
NEXT_PUBLIC_API_URL=/api
BACKEND_API_URL=http://127.0.0.1:8000

# --- PUBLIC APPLICATION CANONICAL URL ---
# The canonical public-facing URL of the Next.js frontend (used for sitemaps, PWA manifest, and OpenGraph SEO)
# Local development default: http://localhost:3000
# Production deployment example: https://log2def.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
