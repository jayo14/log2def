# ==============================================================================
# LOG2DEF FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- BACKEND API REVERSE PROXY ROUTING ---
# Next.js forwards all client /api/* requests to BACKEND_API_URL seamlessly
NEXT_PUBLIC_API_URL=/api
BACKEND_API_URL=http://127.0.0.1:8000

# --- PUBLIC APPLICATION CANONICAL URL ---
# The canonical public-facing URL of the Next.js frontend (used for sitemaps, PWA manifest, and OpenGraph SEO)
# Local development default: http://localhost:3000
# Production deployment example: https://log2def.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- NOTE: Squad & Telegram credentials are backend-only ---
# SQUAD_SECRET_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID must NEVER be exposed to the frontend.
# They are used exclusively by the Django backend for payment initiation, verification, and notifications.
# The frontend only calls /api/projects/<id>/squad/initialize/ which returns a checkout_url.
# Do NOT add SQUAD_SECRET_KEY, SQUAD_PUBLIC_KEY, TELEGRAM_BOT_TOKEN, or TELEGRAM_CHAT_ID here.
