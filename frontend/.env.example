# ==============================================================================
# LOG2DEF FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- BACKEND API REVERSE PROXY & DIRECT ROUTING ---
# Option 1 (Recommended - Built-in Proxy):
# Set NEXT_PUBLIC_API_URL=/api and point BACKEND_API_URL to your Django backend.
# Next.js will forward all client /api/* calls to BACKEND_API_URL with zero CORS issues!
NEXT_PUBLIC_API_URL=/api
BACKEND_API_URL=http://127.0.0.1:8000

# Option 2 (Direct cross-origin API):
# NEXT_PUBLIC_API_URL=https://log2def-backend.onrender.com/api

# --- PUBLIC APPLICATION CANONICAL URL ---
# The canonical public-facing URL of the Next.js frontend (used for sitemaps, PWA manifest, and OpenGraph SEO)
# Local development default: http://localhost:3000
# Production deployment example: https://log2def.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
