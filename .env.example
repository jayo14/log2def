# ==============================================================================
# LOG2DEF ENVIRONMENT CONFIGURATION (PRODUCTION & DEVELOPMENT)
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com,.railway.app,.fly.dev

# --- DATABASE CONFIGURATION ---
DATABASE_URL=
DB_ENGINE=sqlite
DB_NAME=log2def
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# --- AI & MULTIMODAL PROVIDER CONFIGURATION ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- CORS & DOMAIN ORIGIN CONFIGURATION ---
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=https://log2def.com,https://*.vercel.app,https://*.onrender.com,https://*.railway.app

# --- EXTERNAL UTILITIES ---
LIBREOFFICE_PATH=/usr/bin/libreoffice
TESSERACT_CMD=/usr/bin/tesseract

# --- FRONTEND (NEXT.JS) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
