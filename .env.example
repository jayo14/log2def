# Log2Def Environment Configuration

# Django Core
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Leave DB_ENGINE=sqlite for local dev; set to postgres for production)
DB_ENGINE=sqlite
DB_NAME=log2def
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# AI Provider Configuration (Google Gemini Flash & OpenAI Fallback)
# Set your Google AI Studio API key below (https://aistudio.google.com)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback OpenAI-compatible endpoint (Optional)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# External Utilities
LIBREOFFICE_PATH=libreoffice
TESSERACT_CMD=tesseract

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
