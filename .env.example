# Log2Def Environment Configuration

# Django Core
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Leave DB_ENGINE=sqlite for local dev; set to postgres for production)
DB_ENGINE=sqlite
DB_NAME=log2def
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# AI Provider Configuration (OpenAI or compatible provider)
# If AI_API_KEY is left empty, the application runs in robust No-AI Development Mode
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# External Utilities
LIBREOFFICE_PATH=libreoffice
TESSERACT_CMD=tesseract

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
